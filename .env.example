# Solana RPC
# Default: free public mainnet endpoint (rate-limited; fine for learning).
# To use Helius (Developer plan or free tier), set:
#   HELIUS_API_KEY=...
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
#   SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_KEYPAIR_PATH=~/.config/solana/id.json
HELIUS_API_KEY=

# Binance (read-only key, IP-restricted) — Phase 2 (Week 5+)
BINANCE_API_KEY=
BINANCE_SECRET=

# Telegram notifications — Phase 2 (Week 8+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite — Week 4+ (storm-store; a local file, no DB server)
DATABASE_URL=sqlite://./storm.db

# Jito (no key needed; Block Engine endpoint URL configurable) — Phase 4 (Week 14+)
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Dune Analytics — Phase 2 historical dataset ETL (bootstrap/)
# Free plan is sufficient. Used one-time by bootstrap/run.py; never by the
# live collector.
DUNE_API_KEY=
